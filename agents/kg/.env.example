# Wikidata config
SPARQL_ENDPOINT=https://query.wikidata.org/sparql
SPARQL_TIMEOUT=15.0

# DBpedia config (endpoint pubblico: più lento e con rate limit, timeout più alto)
DBPEDIA_ENDPOINT=https://dbpedia.org/sparql
DBPEDIA_TIMEOUT=30.0

# Neo4j config
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
# lasciare vuoto per usare il database di default dell'istanza
NEO4J_DATABASE=
NEO4J_TIMEOUT=15.0

# Ollama config
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TRANSLATION_MODEL=qwen2.5-coder:7b
OLLAMA_LINKING_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=300.0

# Pipeline config
# precaricamento dei modelli locali all'avvio (riduce la latenza della prima domanda)
WARMUP_ON_STARTUP=true
DEFAULT_TARGET_KG=wikidata
MAX_CORRECTION_RETRIES=3
# INFO espone la tracciatura della pipeline nei log del servizio, WARNING la silenzia
LOG_LEVEL=INFO
