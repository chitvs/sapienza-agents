# se si vogliono cambiare alcune impostazioni si può creare un file .env
# questo è un esempio di come dovrebbe essere.

# Wikidata config
WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql
WIKIDATA_TIMEOUT=15.0

# DBpedia config (endpoint pubblico: più lento e con rate limit, timeout più alto)
DBPEDIA_ENDPOINT=https://dbpedia.org/sparql
DBPEDIA_TIMEOUT=30.0

# Neo4j config
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
# lasciare vuoto per usare il database di default dell'istanza
NEO4J_DATABASE=
NEO4J_TIMEOUT=15.0

# Ollama config
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TRANSLATION_MODEL=qwen2.5-coder:7b
OLLAMA_LINKING_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=300.0

# Pipeline config
# precaricamento dei modelli locali all'avvio (riduce la latenza della prima domanda)
WARMUP_ON_STARTUP=true
DEFAULT_TARGET_KG=wikidata
MAX_CORRECTION_RETRIES=3
# attesa base fra i ritentativi per guasto transitorio, moltiplicata per il tentativo
RETRY_BACKOFF_SECONDS=2.0
# candidati recuperati per menzione: è il parametro su cui è misurato l'entity linking
LINKER_CANDIDATES=15
# soglia del NER: sotto 0.35 GLiNER estrae frammenti, sopra perde menzioni
GLINER_SCORE_THRESHOLD=0.35
# bacino della ricerca vettoriale nell'ontologia, da cui si estraggono le verificate
SCHEMA_SEARCH_POOL=25
# proprietà soltanto suggerite mostrate al modello: più contesto, più confusione
SCHEMA_MAX_SUGGESTED=15
# la finestra deve contenere prompt, schema e few-shot: se trabocca il modello perde
# le istruzioni iniziali senza che nulla lo segnali
OLLAMA_NUM_CTX=8192

# Cache semantica (0 la disattiva)
CACHE_CAPACITY=100
CACHE_SIMILARITY_THRESHOLD=0.92

# Ritentativo ReAct: a temperatura 0 la rigenerazione riprodurrebbe la stessa query
RETRY_TEMPERATURE=1.0
RETRY_TOP_P=0.9

# INFO espone la tracciatura della pipeline nei log del servizio, WARNING la silenzia
LOG_LEVEL=INFO
