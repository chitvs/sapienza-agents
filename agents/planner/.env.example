# Provider principale utilizzato dall'agente per la generazione dei piani.
# Valori ammessi: "ollama", "gemini", "openrouter".
# È anche possibile specificare direttamente un modello esatto scavalcando le 
# impostazioni sottostanti, ad esempio: "ollama/llama3.2" o "gemini/gemini-3.6-flash".
LLM_PROVIDER=ollama

# Indirizzo del demone Ollama. 
OLLAMA_HOST=http://localhost:11434
# Modello di default per il fallback locale o se LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# Chiave API per utilizzare i modelli Gemini
GEMINI_API_KEY=
# Modello di default se LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite 

# Chiave API per i modeli OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Lista dei modelli da esporre tramite l'endpoint /models (utile per la UI).
# CRITICO: Inserire i modelli separati SOLO da virgola, senza spazi intermedi 
# e rigorosamente su una singola riga, per evitare che Docker o Pydantic tronchino il valore.
OPENROUTER_MODELS="openai/gpt-oss-20b:free,
nvidia/nemotron-3-ultra-550b-a55b:free,
nvidia/nemotron-3.5-lightning:free,
dots-studio/dots-3-note-preview:free,
z-ai/glm-5.2:free,
poolside/laguna-s-2.1:free"