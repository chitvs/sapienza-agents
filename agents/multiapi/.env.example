# Servizio ora locale: world-time-api3 su RapidAPI
# 1. iscriviti (piano free) su https://rapidapi.com/ e cerca "World Time API"
# 2. copia questo file in .env e incolla la tua chiave QUI SOTTO, SENZA virgolette
# NB: le virgolette finirebbero dentro il valore -> RapidAPI risponde 403 "not subscribed"
TIMEAPI_API_KEY=

# Ollama config
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
